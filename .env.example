# Your backend's base URL. For a physical device testing against your laptop,
# use your machine's LAN IP, not localhost (the device can't reach your laptop's
# localhost) — e.g. http://192.168.1.42:4000
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000

# Same test-mode publishable key as the backend's .env (STRIPE_PUBLISHABLE_KEY).
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
