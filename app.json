{
  "expo": {
    "name": "Free Invoice Maker",
    "slug": "fim",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "freeinvoicemaker",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yourcompany.freeinvoicemaker",
      "infoPlist": {
        "NSCameraUsageDescription": "Not used yet \u2014 reserved for a future receipt-scanning feature.",
        "com.apple.developer.proximity-reader.payment.acceptance": true
      },
      "entitlements": {
        "com.apple.developer.proximity-reader.payment.acceptance": true
      }
    },
    "android": {
      "package": "com.yourcompany.freeinvoicemaker",
      "permissions": [
        "NFC",
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-dev-client",
      "expo-secure-store",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.yourcompany.freeinvoicemaker",
          "enableGooglePay": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "05c34637-a597-48fb-b1d3-90b2e7375fdd"
      }
    },
    "owner": "paydaninc",
    "splash": {
      "backgroundColor": "#FAFAF8"
    }
  }
}
